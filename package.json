{
  "name": "local-project-board",
  "version": "0.0.0",
  "description": "A personal developer board for your Git project in seconds. Local-first, AI-friendly, no ceremony.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "local-project-board": "bin/board.js"
  },
  "files": [
    "bin/",
    "dist/node/",
    "dist/web/",
    "README.md",
    "README.fi.md",
    "README.sv.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "kanban",
    "board",
    "local-first",
    "git",
    "markdown",
    "ai",
    "claude",
    "developer-tools"
  ],
  "scripts": {
    "build": "npm run build:node && npm run build:web",
    "build:node": "tsc -b tsconfig.build.json",
    "build:web": "vite build",
    "clean": "rm -rf dist",
    "typecheck": "tsc -b tsconfig.build.json && tsc -p tsconfig.web.json && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects node",
    "test:pack": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects pack",
    "start": "node bin/board.js"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.20.4",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  }
}
